# Copy this file to .env.local and fill in real values from your Supabase project
# (Supabase Dashboard > Project Settings > API).

# Safe to expose to the browser — used by the public site and the client SDK.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-ONLY. Never expose this to the browser or commit it.
# Used only for admin employee management (creating Auth users).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
